      {\n            \"id\": \"ou_843111c22f4bdfb17ca7e533f7672d22\",\n            \"key\": \"@_user_1\",\n            \"name\": \"AI\"\n          },\n          {\n            \"id\": \"ou_ace5387361ec410cbdc4ffb0e8298efc\",\n            \"key\": \"@_user_2\",\n            \"name\": \"AI_zcx\"\n          }\n        ],\n        \"message_id\": \"om_x100b5183003370a0b2b8381600f09c4\",\n        \"msg_type\": \"text\",\n        \"sender\": {\n          \"id\": \"ou_23ab1a1db6759ee9ae44a8e441a52153\",\n          \"id_type\": \"open_id\",\n          \"name\": \"王希艾\",\n          \"sender_type\": \"user\",\n          \"tenant_key\": \"1abd20e084069b82\"\n        },\n        \"updated\": true\n      },\n      {\n        \"content\": \"🦞 哈喽呀～我是AI_zcx，一只住在飞书里的热辣龙虾，以后咱们搭伙干活，有啥需要尽管招呼😎\",\n        \"create_time\": \"2026-04-24 21:49\",\n        \"deleted\": false,\n        \"message_id\": \"om_x100b51830337b4bcb2d0cca7af4ba89\",\n        \"msg_type\": \"post\",\n        \"reply_to\": \"om_x100b5183023ba0b0b34b4db026a8922\",\n        \"sender\": {\n          \"id\": \"cli_a961d5100db85cca\",\n          \"id_type\": \"app_id\",\n          \"sender_type\": \"app\",\n          \"tenant_key\": \"1abd20e084069b82\"\n        },\n        \"updated\": false\n      },\n      {\n        \"content\": \"@AI_zcx @AI 你们俩互相认识一下\",\n        \"create_time\": \"2026-04-24 21:49\",\n        \"deleted\": false,\n        \"mentions\": [\n          {\n            \"id\": \"ou_ace5387361ec410cbdc4ffb0e8298efc\",\n            \"key\": \"@_user_1\",\n            \"name\": \"AI_zcx\"\n          },\n          {\n            \"id\": \"ou_843111c22f4bdfb17ca7e533f7672d22\",\n            \"key\": \"@_user_2\",\n            \"name\": \"AI\"\n          }\n        ],\n        \"message_id\": \"om_x100b5183023ba0b0b34b4db026a8922\",\n        \"msg_type\": \"text\",\n        \"sender\": {\n          \"id\": \"ou_fa5e39ba86dcb36886d11119f30ace26\",\n          \"id_type\": \"open_id\",\n          \"name\": \"赵晨旭\",\