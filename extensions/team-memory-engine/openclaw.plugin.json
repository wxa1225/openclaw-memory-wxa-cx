{
  "id": "team-memory-engine",
  "description": "Team Cognitive Infrastructure — Memory OS with Ledger, Graph, and Risk Model",
  "homepage": "https://github.com/openclaw/team-memory-engine",
  "kind": "memory",
  "uiHints": {
    "teamId": {
      "label": "Team ID",
      "placeholder": "openclaw-team",
      "help": "Unique identifier for the team sharing memories"
    },
    "decayCheckInterval": {
      "label": "Decay Check Interval",
      "placeholder": "1800000",
      "help": "Milliseconds between decay checks (default: 30 min = 1800000)"
    },
    "riskCheckInterval": {
      "label": "Risk Check Interval",
      "placeholder": "3600000",
      "help": "Milliseconds between risk assessments (default: 60 min = 3600000)"
    },
    "feishuChatId": {
      "label": "Feishu Chat ID",
      "placeholder": "oc_xxx",
      "help": "Feishu group chat ID for review/risk reminder push"
    },
    "teamSize": {
      "label": "Team Size",
      "placeholder": "5",
      "help": "Number of team members (used for coverage calculation)"
    },
    "enableGraph": {
      "label": "Enable Memory Graph",
      "placeholder": "true",
      "help": "Automatically build and maintain the memory knowledge graph"
    }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "teamId": { "type": "string" },
      "decayCheckInterval": { "type": "number" },
      "riskCheckInterval": { "type": "number" },
      "feishuChatId": { "type": "string" },
      "teamSize": { "type": "number" },
      "enableGraph": { "type": "boolean" },
      "projectRoot": { "type": "string" },
      "modelEndpoint": { "type": "string" },
      "modelApiKey": { "type": "string" },
      "modelName": { "type": "string" },
      "modelXApiKey": { "type": "string" },
      "extractionBatchSize": { "type": "number" }
    },
    "required": []
  }
}
